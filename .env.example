# =============================================================================
# ENVIRONMENT TEMPLATE - Healthcare System NS
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Get these from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key (KEEP SECRET - server-side only)
# Used for admin operations, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Site Configuration
# -----------------------------------------------------------------------------
# Public URL of your deployed application
VITE_SITE_URL=https://your-domain.com
SITE_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Email Configuration (Resend)
# -----------------------------------------------------------------------------
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
SIGNUP_EMAIL_FROM=Your App <noreply@your-domain.com>

# -----------------------------------------------------------------------------
# Email Configuration (SMTP - Gmail)
# -----------------------------------------------------------------------------
# For Gmail, use App Password: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM_NAME=Your App Name

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------
# STT (Speech-to-Text) + NLP Backend
VITE_STT_API_URL=https://your-stt-api-endpoint.com

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Encryption key for sensitive data (CCCD, phone, medical records)
# Generate new key: openssl rand -base64 32
VITE_ENCRYPTION_SECRET_KEY=your-32-byte-base64-encoded-key
